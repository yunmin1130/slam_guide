{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "baseUrl": ".",
    "paths": {
      "@core/prev/*": ["core/reference/*"],
      "@core/*": ["core/*"]
    },
    "types": ["node"]
  },
  "include": ["core/**/*.ts", "vitest.config.ts"]
}
