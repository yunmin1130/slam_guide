---
/** 대시보드: 다음 세션(기기별) + 레슨 목록. 메타데이터는 레슨 frontmatter에서 자동 생성 (LESSON_TEMPLATE §2) */
import Base from "../layouts/Base.astro";
import Dashboard from "../components/Dashboard";
import { getLessons, toLessonMeta } from "../lib/lessons";
import { PLANNED } from "../lib/roadmap";

const lessons = (await getLessons()).map(toLessonMeta);
const core = lessons.filter((l) => l.track === "core");
const coreUnits = core.reduce((sum, l) => sum + l.units, 0) + PLANNED.reduce((sum, p) => sum + p.units, 0);
---

<Base title="SLAM 학습">
  <header class="hero">
    <span class="eyebrow">카메라 기하에서 3D 재구성·센서 시뮬레이션까지</span>
    <h1>오늘 할 세션 하나만.</h1>
    <p class="lede">
      핵심 레슨 {core.length + PLANNED.length}개(준비 중 {PLANNED.length}개) · {coreUnits}단위. 수학은 직접 짜고, 그림은 사이트가 그린다.
    </p>
  </header>
  <Dashboard client:load lessons={lessons} planned={PLANNED} />
</Base>

<style>
  .hero h1 {
    font-size: clamp(2rem, 1.4rem + 3vw, 2.8rem);
    letter-spacing: -0.03em;
    margin: var(--space-1) 0 var(--space-2);
  }
  .lede {
    color: var(--ink-soft);
    margin-bottom: var(--space-6);
  }
</style>
