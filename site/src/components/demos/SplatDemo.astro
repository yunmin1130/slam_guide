---
/**
 * SplatDemo 데모 래퍼 (4b주차). 빌드 시점에 테스트 상태를 구해 island에 넘긴다.
 * 그림은 SVG 세 장이라 WebGL을 쓰지 않는다. 화면에 보일 때만 불러온다 (client:visible).
 * 토글 배지는 데모가 부르는 손코딩 함수만 본다 (읽기만 함수 buildCovariance는 늘 정답이다).
 */
import { fnStatus } from "../../lib/implStatus";
import { requireLesson } from "../lesson/context";
import SplatDemo from "./SplatDemo";

const lesson = requireLesson(Astro.locals, "SplatDemo");
const DEMO_FNS = ["projectCovariance", "gaussianWeight2D", "alphaComposite"];
const statuses = lesson.tasks.filter((fn) => DEMO_FNS.includes(fn)).map((fn) => ({ fn, status: fnStatus(lesson.week, fn) }));
---

<SplatDemo client:visible week={lesson.week} statuses={statuses} />
