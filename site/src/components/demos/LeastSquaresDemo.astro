---
/**
 * LeastSquaresDemo 데모 래퍼 (2주차). 빌드 시점에 테스트 상태를 구해 island에 넘긴다.
 * 그림은 SVG 한 장이라 WebGL을 쓰지 않는다. 화면에 보일 때만 불러온다 (client:visible).
 * 데모는 solveLeastSquares만 부른다 (nullspaceSVD는 개념 그림 MatrixWarp가 직관만 보여 준다).
 */
import { fnStatus } from "../../lib/implStatus";
import { requireLesson } from "../lesson/context";
import LeastSquaresDemo from "./LeastSquaresDemo";

const lesson = requireLesson(Astro.locals, "LeastSquaresDemo");
const DEMO_FNS = ["solveLeastSquares"];
const statuses = lesson.tasks.filter((fn) => DEMO_FNS.includes(fn)).map((fn) => ({ fn, status: fnStatus(lesson.week, fn) }));
---

<LeastSquaresDemo client:visible week={lesson.week} statuses={statuses} />
