---
/**
 * 과제 카드. frontmatter의 tasks(손코딩)·read_only(읽기만) 함수마다 하나 (LESSON_TEMPLATE §3 ④).
 * 사용: <TaskCard fn="skew">설명 + <Hint level={1}>…</Hint></TaskCard>
 *       <TaskCard fn="dot" readOnly>설명</TaskCard>
 * 테스트 상태는 빌드 시점의 test-results.json에서 온다 (lib/implStatus.ts).
 */
import { Code } from "astro:components";
import { STATUS_LABEL, type FnStatus } from "../../lib/impl";
import { fnStatus, syntaxMessage } from "../../lib/implStatus";
import { contentHash, isCiStub, normalizeNewlines } from "../../lib/playground/draft";
import CodePlayground from "./CodePlayground";
import { coreFile, githubDevUrl, githubUrl, mineSource, referenceFunctionSource, requireLesson } from "./context";

interface Props {
  fn: string;
  readOnly?: boolean;
}

const { fn, readOnly = false } = Astro.props;
const lesson = requireLesson(Astro.locals, "TaskCard");
const field = readOnly ? "read_only" : "tasks";
if (!lesson[field].includes(fn)) {
  throw new Error(`${lesson.key}: <TaskCard fn="${fn}">가 frontmatter ${field}에 없다`);
}
const source = referenceFunctionSource(lesson.fileKey, fn);
if (!source) throw new Error(`core/reference/${lesson.fileKey}.ts에 ${fn} 함수가 없다`);

const status = fnStatus(lesson.week, fn);
const TONE: Record<FnStatus, string> = { pass: "mine", todo: "ref", missing: "ref", fail: "fail", "syntax-error": "fail" };
const tone = readOnly ? "muted" : TONE[status];
// 읽기만 카드는 위 eyebrow가 이미 "읽기만"이라 배지는 무엇을 쓰는지만 말한다
const label = readOnly ? "reference 사용" : STATUS_LABEL[status];
// 구문 오류(syntax-error)와 import 오류(결과 없음으로 나옴) 모두 메시지를 보여준다
const syntax = readOnly ? undefined : syntaxMessage(lesson.week);
const minePath = coreFile("mine", lesson.fileKey);
// 코드 연습장 시작 내용 = 지금 배포되는 core/mine 파일 (CI가 구문 오류 파일을 스텁으로 바꿨다면 그 스텁)
const mineText = readOnly ? undefined : mineSource(lesson.fileKey);
if (!readOnly && mineText === undefined) throw new Error(`core/mine/${lesson.fileKey}.ts가 없다`);
const initialSource = mineText === undefined ? "" : normalizeNewlines(mineText);
---

<article class="task" id={`task-${fn}`} data-readonly={readOnly ? "" : undefined}>
  <header class="task-head">
    <span class="eyebrow">{readOnly ? "읽기만" : "손코딩"} · {lesson.key}</span>
    <h3 class="task-name"><code>{fn}</code></h3>
    <span class="badge" data-tone={tone}>{label}</span>
  </header>

  <div class="task-body"><slot /></div>

  {syntax && <pre class="task-syntax">{syntax}</pre>}

  {
    readOnly ? (
      <details class="fold">
        <summary>reference 코드 읽기</summary>
        <div class="fold-body">
          <Code code={source} lang="ts" wrap themes={{ light: "github-light", dark: "github-dark" }} />
        </div>
      </details>
    ) : (
      <footer class="task-foot">
        <CodePlayground
          client:visible
          week={lesson.fileKey}
          fn={fn}
          path={minePath}
          initialSource={initialSource}
          buildHash={contentHash(initialSource)}
          buildIsStub={isCiStub(initialSource)}
        />
        <a class="task-link" href={githubDevUrl(minePath)}>github.dev에서 편집</a>
        <a class="task-link" href={githubUrl(minePath)}>{minePath}</a>
        <div class="task-run">
          <span class="eyebrow">PC에서 이 함수만 테스트</span>
          <pre class="task-cmd"><code>{`npx vitest --project mine\n  -t ${fn}`}</code></pre>
        </div>
      </footer>
    )
  }
</article>

<style>
  .task {
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow);
    padding: var(--space-4);
    margin: var(--space-6) 0;
  }
  .task[data-readonly] {
    background: transparent;
    box-shadow: none;
    border-style: dashed;
  }
  .task-head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0 var(--space-3);
  }
  .task-head .eyebrow {
    grid-column: 1 / -1;
  }
  .task-name {
    margin: 0;
    font-size: var(--text-lg);
  }
  .task-name code {
    background: none;
    padding: 0;
  }
  .task-body {
    margin-top: var(--space-3);
  }
  .task-syntax {
    color: var(--fail);
    background: var(--fail-bg);
    white-space: pre-wrap;
  }
  .task-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    border-top: 1px dashed var(--rule);
    margin-top: var(--space-3);
    padding-top: var(--space-2);
  }
  /* 44px 터치 영역이 눈에 보이게 알약 모양으로 (글자만 있으면 작아 보여 잘못 누르기 쉽다) */
  .task-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    margin: var(--space-1) 0;
    padding: 0 var(--space-3);
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }
  .task-run {
    width: 100%;
    margin: var(--space-2) 0 0;
  }
  /* 폰 폭에서 한 줄에 안 들어가므로 -t 이름을 일부러 다음 줄에 둔다. 함수 이름이 아주 길면 그 안에서만 줄바꿈 */
  .task-cmd {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .task-cmd code {
    background: none;
    padding: 0;
  }
</style>
